{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Joainas POS",
  "version": "1.3.8",
  "identifier": "com.joainas.pos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Joainas Supermarket & Coldstore - Point of Sale",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: blob:; connect-src 'self' ipc: http://ipc.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Dronebug Technologies and Services",
    "copyright": "Copyright (c) 2026 Joainas Supermarket and Coldstore. All Rights Reserved.",
    "category": "Business",
    "shortDescription": "Point of Sale & Inventory Management System for Supermarket and Coldstore Operations",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
